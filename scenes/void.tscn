[sub_resource type="GDScript" id="GDScript_8wjpf"]
script/source = "extends Node3D

@onready var anim: AnimationPlayer = $AnimationPlayer
@onready var animVoid: AnimationPlayer = $\"../../Customer/AnimationPlayer\"
@onready var camera: Camera3D = $\"..\"

@onready var animCircle: AnimationPlayer = $\"../../DirectionalLight3D/AnimationPlayer\"




# STATE MACHINE
enum {
	STATE_IDLE,
	STATE_CHARGING,
	STATE_CASTED,
	STATE_BITE,
	STATE_MINIGAME,
	STATE_ROTATING
}

var state: int = STATE_IDLE

var paused: bool = false



func _ready() -> void:
	camera. start_screenshake(0.3,15)
	anim.play(\"idle\")
	animVoid.play(\"walk\")
	animCircle.play(\"circle\")
	
	await animVoid.animation_finished
	var echo := preload(\"res://scenes/event_echo.tscn\").instantiate()
	get_tree().current_scene.add_child(echo)
	AudioServer.set_bus_mute(
		AudioServer.get_bus_index(\"Music\"),
		true
	)
	AudioServer.set_bus_mute(
	AudioServer.get_bus_index(\"SFX\"),
		true
	)
	echo.set_event(
		EventEcho.EventType.ICE_STORM,
		tr(\"EVENT_ICELAND\")
	)

	await get_tree().create_timer(10).timeout
	AudioServer.set_bus_mute(
	AudioServer.get_bus_index(\"Music\"),
	false
	)
	AudioServer.set_bus_mute(
	AudioServer.get_bus_index(\"SFX\"),
	false
	)
	Player.update_last_scene(\"res://scenes/iceland.tscn\")
	Transition.change_scene(\"res://scenes/MapScene.tscn\")

		
"

