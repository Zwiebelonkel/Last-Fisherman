[sub_resource type="Shader" id="Shader_crt"]
code = "shader_type canvas_item;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_nearest, repeat_disable;
uniform float grain_intensity : hint_range(0.0, 1.0) = 0.08;
uniform float scanline_intensity : hint_range(0.0, 1.0) = 0.25;
uniform float vignette_darkness : hint_range(0.0, 1.0) = 0.55;
uniform float barrel_distortion : hint_range(0.0, 0.5) = 0.08;
uniform float warble_amount : hint_range(0.0, 0.01) = 0.001;
uniform float warble_speed : hint_range(0.0, 10.0) = 1.2;

float noise(vec2 p) {
	return (fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) * 2.0;
}

void fragment() {
	vec2 uv = SCREEN_UV;
	vec2 center_uv = uv - 0.5;
	float r2 = dot(center_uv, center_uv);
	vec2 distorted_uv = center_uv * (1.0 + barrel_distortion * r2) + 0.5;

	if (distorted_uv.x < 0.0 || distorted_uv.x > 1.0 || distorted_uv.y < 0.0 || distorted_uv.y > 1.0) {
		COLOR = vec4(0.0, 0.0, 0.0, 1.0);
	} else {
		vec2 warble = vec2(
			sin(TIME * warble_speed + uv.x * 10.0) * cos(TIME * warble_speed * 0.7 + uv.y * 7.0),
			cos(TIME * warble_speed * 0.8 + uv.y * 11.0) * sin(TIME * warble_speed * 0.9 + uv.x * 8.0)
		) * warble_amount;
		vec2 final_uv = clamp(distorted_uv + warble, vec2(0.0), vec2(1.0));
		vec3 col = texture(SCREEN_TEXTURE, final_uv).rgb;

		vec2 grain_uv = uv + vec2(sin(TIME * 0.5), cos(TIME * 0.5)) * 20.0;
		float g = noise(grain_uv) * grain_intensity;
		col = clamp(col + vec3(g), 0.0, 1.0);

		vec2 screen_size = 1.0 / SCREEN_PIXEL_SIZE;
		float scanline = sin(uv.y * screen_size.y * 3.0);
		scanline = clamp(scanline * 0.5 + 0.5, 0.0, 1.0);
		col *= 1.0 - (scanline * scanline_intensity);

		float aspect = screen_size.x / screen_size.y;
		vec2 adj = (uv - 0.5);
		adj.x *= aspect;
		float vdist = length(adj);
		float vfactor = mix(1.0 - vignette_darkness, 1.0, smoothstep(0.7, 0.2, vdist));
		col *= vfactor;

		vec2 dc = distorted_uv - 0.5;
		col *= pow(1.0 - clamp(dot(dc, dc), 0.0, 1.0), 0.5);

		COLOR = vec4(col, 1.0);
	}
}"

