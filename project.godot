; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Last Fisherman"
config/description="Catastrophic fishing simulator"
config/version="1.0"
run/main_scene="uid://cnnms2yc7xfm1"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/image="uid://duvvsfsrxg6uw"
config/icon="uid://duvvsfsrxg6uw"
config/windows_native_icon="res://assets/logo.ico"

[autoload]

FileLogger="*res://scripts/FileLogger.gd"
ShaderWarmup="*res://scripts/shader_warmup.gd"
FishDB="*res://scripts/FishDatabase.gd"
GodotSteam="*res://scripts/godotsteam.gd"
SteamAchievements="*res://scripts/SteamAchievements.gd"
Player="*res://scripts/Player.gd"
Inventory="*res://scripts/inventar.gd"
FishBook="*res://scripts/FishBook.gd"
Transition="*res://scripts/transition.gd"
LoreManager="*res://scripts/LoreManager.gd"
FlowManager="*res://scripts/FlowManager.gd"
Freecam="*res://scripts/Freecam.gd"

[display]

window/size/mode=4
window/stretch/mode="canvas_items"
window/handheld/orientation=1

